{
  "name": "grabmeta",
  "version": "2.3.3",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.18.0 || >=24.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "run-p type-check \"build-only {@}\" --",
    "preview": "vite preview",
    "build-only": "vite build",
    "type-check": "vue-tsc --build",
    "lint": "eslint . --fix",
    "format": "prettier --write src/",
    "tauri": "tauri",
    "desktop:dev": "tauri dev",
    "desktop:build": "node scripts/build-desktop.mjs",
    "desktop:build:install-test": "node scripts/build-desktop.mjs --config src-tauri/tauri.install-test.conf.json",
    "check:rust": "cargo check --manifest-path src-tauri/Cargo.toml",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml",
    "test": "node --test tests/*.test.mjs",
    "lint:check": "eslint .",
    "tools:check": "node scripts/check-tools.mjs",
    "test:desktop": "node scripts/smoke-desktop.mjs",
    "test:ui": "node scripts/smoke-ui.mjs",
    "test:guide": "node scripts/smoke-guide.mjs",
    "test:install-resources": "powershell.exe -NoProfile -NonInteractive -ExecutionPolicy Bypass -File scripts/smoke-install-resources.ps1",
    "licenses:installed": "node scripts/verify-installed-licenses.mjs",
    "licenses:check": "node scripts/check-licenses.mjs",
    "licenses:release": "node scripts/check-licenses.mjs --release",
    "test:tools": "node scripts/smoke-tools.mjs",
    "licenses:collect": "node scripts/collect-license-supplements.mjs && node scripts/collect-dependency-notices.mjs",
    "licenses:inventory": "node scripts/collect-dependency-notices.mjs",
    "licenses:redistribution": "node scripts/collect-redistribution-materials.mjs"
  },
  "dependencies": {
    "@arco-design/web-vue": "^2.57.0",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2",
    "@tauri-apps/plugin-opener": "^2.7.0",
    "number-precision": "file:vendor/number-precision",
    "pinia": "~2.1.7",
    "tdesign-icons-vue-next": "^0.3.7",
    "tdesign-vue-next": "^1.15.4",
    "vue": "^3.5.43",
    "vue-i18n": "^11.4.13",
    "vue-router": "~4.3.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@tsconfig/node22": "^22.0.2",
    "@types/node": "^22.16.5",
    "@vitejs/plugin-vue": "^6.0.9",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/tsconfig": "^0.7.0",
    "eslint": "^9.31.0",
    "eslint-plugin-vue": "^10.11.1",
    "jiti": "^2.4.2",
    "npm-run-all2": "^8.0.4",
    "playwright-core": "^1.63.0",
    "prettier": "3.6.2",
    "sass": "^1.90.0",
    "typescript": "^5.4.5",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.3.3",
    "vue-tsc": "^3.3.12"
  },
  "overrides": {
    "number-precision": "$number-precision"
  }
}
