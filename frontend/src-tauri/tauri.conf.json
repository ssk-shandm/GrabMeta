{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "GrabMeta",
  "mainBinaryName": "GrabMeta",
  "version": "2.3.3",
  "identifier": "com.ssk-shandm.grabmeta",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run licenses:check && npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "GrabMeta 中文版",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 640
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: http://asset.localhost http: https: data: blob:; connect-src ipc: http://ipc.localhost https://api.github.com https://github.com https://*.githubusercontent.com; font-src 'self' data:; object-src 'none'; base-uri 'self'; frame-src 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/icon.ico",
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png"
    ],
    "resources": {
      "../../LICENSE": "LICENSE",
      "../../licenses": "licenses"
    },
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "SimpChinese",
          "English"
        ],
        "displayLanguageSelector": true,
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico"
      }
    },
    "copyright": "Copyright (c) 2025 ssk-shandm",
    "license": "MIT",
    "licenseFile": "../../licenses/gui/INSTALLER-NOTICE.txt"
  }
}
