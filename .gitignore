# Python caches, environments, and test artifacts
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
env/
ENV/
*.egg-info/
.eggs/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.tox/
.nox/
.coverage*
htmlcov/

# Vue / Vite / Node.js
node_modules/
frontend/dist/
frontend/.vite/
*.tsbuildinfo
.npm/
.pnpm-store/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Local configuration and runtime data
.env
.env.*
!.env.example
!.env.sample
/downloads/
/config/
/tmp_ffmpeg_download/
/bin/
/chrome-portable/
*.log

# Retired root PyInstaller outputs (prevent accidental reintroduction)
/build/
/dist/
/grabmeta.spec
/yt-dlp-gui-cn.spec
/icon.ico

# Editors and operating systems
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# Tauri / Rust
/frontend/src-tauri/target/
/frontend/src-tauri/gen/
/frontend/src-tauri/.tauri/

# Never commit updater signing secrets
*.key
*.key.pub

/frontend/src-tauri/target-*/
/.grabmeta-install-*/
/.grabmeta-bin-backup/
# Pre-2.3.3 names; kept so stale local evidence stays ignored.
/.ytdlp-gui-install-*/
/.ytdlp-gui-bin-backup/

# Screenshots, raw artwork, downloads and local test evidence
*.png
*.jpg
*.jpeg
*.webp
*.gif
*.bmp
*.tif
*.tiff
*.psd
*.mp4
*.mkv
*.webm
*.mov
*.mp3
*.m4a
*.wav
*.part
*.ytdl
*.zip
*.7z
*.rar
*.exe
*.msi
/screenshots/
/test-results/
/playwright-report/

# Keep the application icons needed by Tauri/NSIS in clean checkouts.
!/frontend/src-tauri/icons/*.png
